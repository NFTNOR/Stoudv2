# STOUD Server — Environment Variables
# Copy this file to .env and fill in the values
# Run: node setup-password.js  to generate SESSION_SECRET and ADMIN_PASSWORD_HASH

NODE_ENV=production
PORT=3000

# Random 64-byte hex string — generated by setup-password.js
SESSION_SECRET=

# Bcrypt hash of admin password — generated by setup-password.js
ADMIN_PASSWORD_HASH=
